{
  "name": "phishnet",
  "version": "1.0.0",
  "description": "Provenance-aware security platform for human-AI and agent-to-agent financial interactions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local apps/api/src/server.js",
    "test": "node tests/run-all.js",
    "test:native": "powershell -ExecutionPolicy Bypass -File tests/run-tests.ps1",
    "serve": "powershell -ExecutionPolicy Bypass -File apps/api/serve.ps1",
    "test:unit": "node tests/investigations.test.js",
    "test:browser": "playwright test",
    "test:chain": "node --experimental-strip-types tests/chain-safety.test.mjs",
    "build": "node scripts/build-web.mjs",
    "predev": "npm run build",
    "test:payments": "node tests/payments.test.js",
    "test:testnet-api": "node scripts/test-testnet-api.mjs",
    "test:consent": "node tests/consent.test.js",
    "test:notebook": "node tests/notebook.test.js",
    "test:consent-api": "node scripts/test-consent-api.mjs",
    "test:mvp": "node scripts/test-mvp.mjs",
    "agent:tool": "node scripts/agent-tool.mjs",
    "verify:audit": "node scripts/verify-audit.mjs"
  },
  "keywords": [
    "agentic-payments",
    "security",
    "provenance",
    "merkle-proof",
    "arc-testnet",
    "usdc",
    "social-engineering",
    "financial-authorization"
  ],
  "author": "PhishNet Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@countersignlabs/counter-sign": "0.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cytoscape": "3.35.0",
    "viem": "2.58.7"
  },
  "overrides": {
    "nodemailer": "10.1.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
