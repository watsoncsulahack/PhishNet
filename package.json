{
  "name": "phishnet",
  "version": "1.0.0",
  "description": "Provenance-aware security platform for human-AI and agent-to-agent financial interactions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node apps/api/src/server.js",
    "test": "node tests/run-all.js",
    "test:native": "powershell -ExecutionPolicy Bypass -File tests/run-tests.ps1",
    "serve": "powershell -ExecutionPolicy Bypass -File apps/api/serve.ps1",
    "test:unit": "node tests/investigations.test.js",
    "test:browser": "playwright test",
    "test:chain": "node --experimental-strip-types tests/chain-safety.test.mjs",
    "test:payments": "node tests/payments.test.js"
  },
  "keywords": [
    "agentic-payments",
    "security",
    "provenance",
    "merkle-proof",
    "arc-testnet",
    "usdc",
    "social-engineering",
    "financial-authorization"
  ],
  "author": "PhishNet Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "viem": "2.58.7"
  }
}
