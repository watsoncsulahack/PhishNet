# Local app configuration. No financial private keys belong here. npm run dev loads .env.local.
# Shell example: PORT=3001 npm run dev
PORT=3001
HOST=127.0.0.1

# Direct payments use a connected browser wallet and the fixed official network:
# Arc Testnet 5042002 / https://rpc.testnet.arc.io
# Native USDC uses 18 decimals; input accepts up to 6 decimal places.
# The app never reads a private-key environment variable or signs on the server.
# Optional free/managed HTTPS RPC overrides for testing or rate-limit offload:
# PHISHNET_ARC_RPC_URL=https://rpc.testnet.arc.io
# PHISHNET_ARC_RPC_FALLBACK_URLS=https://rpc.quicknode.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.blockdaemon.testnet.arc.io
# PHISHNET_ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# OPTIONAL independent human consent profile (public key only).
# Enroll on a separate human-controlled device, then set before starting the app.
# If set, each in-app payment requires a valid keyed counter-sign 0.2 receipt
# AND explicit external wallet approval. No human signing secret belongs here.
# COUNTERSIGN_APPROVER_PUBLIC_KEY=<canonical-base64url-raw-ed25519-public-key>

# OPTIONAL wallet-scoped local agent capability from Settings (not an AI provider key).
# Keep the actual value only in ignored .env.local; never commit it.
# PHISHNET_AGENT_TOKEN=<local-agent-capability>
# PHISHNET_URL=http://127.0.0.1:3001
# PHISHNET_AGENT_BACKEND=antigravity # antigravity | codex | custom | manual
# PHISHNET_AGY_MODEL=
# PHISHNET_CODEX_MODEL=
